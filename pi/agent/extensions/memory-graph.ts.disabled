import { type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { StringEnum } from "@earendil-works/pi-ai";
import { Type } from "typebox";

// Standalone CLI built by ~/iCYLON/memory_graph (uv). No PATH dependency.
const CLI = "/Users/sadith/iCYLON/memory_graph/.venv/bin/memory-graph";

const actions = ["query", "find", "doctor", "index"] as const;
type Action = (typeof actions)[number];

function argsFor(action: Action, p: {
	question?: string;
	host?: string;
	file?: string;
	state?: string;
	link?: string;
	starthere?: boolean;
}): string[] {
	switch (action) {
		case "query":
			if (!p.question) throw new Error("query requires a question");
			return ["query", p.question];
		case "find": {
			const a = ["find"];
			if (p.host) a.push("--host", p.host);
			if (p.file) a.push("--file", p.file);
			if (p.state) a.push("--state", p.state);
			if (p.link) a.push("--link", p.link);
			if (p.starthere) a.push("--starthere");
			if (a.length === 1) throw new Error("find requires at least one filter (host/file/state/link/starthere)");
			return a;
		}
		case "doctor": return ["doctor"];
		case "index": return ["index"];
	}
}

export default function (pi: ExtensionAPI) {
	pi.registerTool({
		name: "memory-graph",
		label: "Operational Memory Graph",
		description: "Query the iCYLON operational-memory corpus (~/.claude/.../memory + ~/iCYLON/memories) as a temporal graph: semantic+lexical anchor, wikilink neighbors, deploy-state and stale/superseded flags. No SQL.",
		promptSnippet: "Use memory-graph before any iCYLON infra/deploy/'where does X run'/'what's deployed' question, instead of grepping the memory .md files.",
		promptGuidelines: [
			"Use `query` with a natural-language question for symptom-level lookups (e.g. 'Why is IL5 not rescanning after hardening?'); read the returned notes AND their linked neighbors before reasoning.",
			"Use `find` for exact filters: --host <ip>, --file <name>, --state DEPLOYED|UNDEPLOYED|STAGED, --link <slug> (backlinks), --starthere.",
			"Deploy state is ground truth: a note tagged STALE has been superseded — prefer its superseder. Never report infra state from training; cite the note.",
			"Run `index` only after the memory corpus changes; `doctor` shows index status.",
		],
		parameters: Type.Object({
			action: StringEnum(actions),
			question: Type.Optional(Type.String({ description: "Natural-language question for the `query` action." })),
			host: Type.Optional(Type.String({ description: "IP/host substring for `find`." })),
			file: Type.Optional(Type.String({ description: "File-name substring for `find`." })),
			state: Type.Optional(Type.String({ description: "Deploy-state token for `find`: DEPLOYED|UNDEPLOYED|STAGED|LIVE|PENDING." })),
			link: Type.Optional(Type.String({ description: "Note slug — `find` returns its backlinks." })),
			starthere: Type.Optional(Type.Boolean({ description: "`find` only START HERE entry-point notes." })),
		}),
		async execute(_id, params, signal, onUpdate) {
			const args = argsFor(params.action, params);
			onUpdate?.({ content: [{ type: "text", text: `memory-graph ${params.action}` }], details: {} });
			const result = await pi.exec(CLI, args, { signal, timeout: 120_000 });
			const text = [result.stdout, result.stderr].filter(Boolean).join("\n").trim() || "No output.";
			if (result.code !== 0) throw new Error(text);
			return { content: [{ type: "text" as const, text }], details: { action: params.action, code: result.code } };
		},
	});
}
